<style>
.xmrpay-settings { max-width: 960px; }
.xmrpay-settings__intro { border-left: 4px solid #ff6600; padding-left: 16px; margin-bottom: 24px; }
.xmrpay-settings fieldset { border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px; margin-bottom: 20px; min-width: 0; }
.xmrpay-settings legend { float: none; width: auto; font-size: 1.1rem; font-weight: 600; padding: 0 6px; margin-bottom: 8px; }
.xmrpay-settings .form-text { margin-bottom: 0; }
.xmrpay-settings details { overflow-wrap: anywhere; }
.xmrpay-settings summary { cursor: pointer; font-weight: 600; margin-bottom: 12px; }
</style>
<div class="xmrpay-settings">
<div class="xmrpay-settings__intro">
    <h3>Monero payments</h3>
    <p>Receive payments with your primary address and private view key. XMRPay Watch checks incoming payments through your Monero nodes.</p>
</div>
<fieldset>
<legend>Wallet</legend>
<div class="mb-3">
    <?php $this->Form->label('Monero network', 'network', ['class' => 'form-label']); ?>
    <?php $this->Form->fieldSelect('network', ['mainnet' => 'Mainnet', 'stagenet' => 'Stagenet', 'testnet' => 'Testnet'], $meta['network'] ?? 'mainnet', ['id' => 'network', 'class' => 'form-select']); ?>
</div>
<div class="mb-3">
    <?php $this->Form->label('Primary wallet address', 'address', ['class' => 'form-label']); ?>
    <?php $this->Form->fieldText('address', $meta['address'] ?? '', ['id' => 'address', 'class' => 'form-control']); ?>
</div>
<div class="mb-3">
    <?php $this->Form->label('Private view key', 'view_key', ['class' => 'form-label']); ?>
    <?php $this->Form->fieldPassword('view_key', ['value' => $meta['view_key'] ?? '', 'id' => 'view_key', 'class' => 'form-control', 'autocomplete' => 'off']); ?>
    <p class="form-text">Never enter a seed phrase or private spend key.</p>
</div>
</fieldset>
<fieldset>
<legend>Nodes</legend>
<div class="mb-3">
    <?php $this->Form->label('Monero nodes (one URL per line, or authenticated node JSON)', 'nodes', ['class' => 'form-label']); ?>
    <?php $this->Form->fieldTextarea('nodes', $meta['nodes'] ?? '', ['id' => 'nodes', 'class' => 'form-control', 'rows' => 4]); ?>
    <p class="form-text">Use a monerod HTTP(S) RPC endpoint. For one trusted node, set Minimum distinct nodes to 1. Inside a container, 127.0.0.1 refers to that container.</p>
</div>
<div>
    <?php $this->Form->label('Minimum distinct nodes', 'minimum_nodes', ['class' => 'form-label']); ?>
    <?php $this->Form->fieldText('minimum_nodes', $meta['minimum_nodes'] ?? 2, ['id' => 'minimum_nodes', 'class' => 'form-control', 'inputmode' => 'numeric']); ?>
</div>
</fieldset>
<fieldset>
<legend>Payment rules</legend>
<div class="row">
<?php
$paymentSettings = [
    'min_confirmations' => ['Confirmations required', 10],
    'index_offset' => ['Subaddress index offset', 1000000],
    'invoice_minutes' => ['Quote validity in minutes', 60],
    'abandoned_hours' => ['Watch unpaid quotes after expiry (hours)', 24]
];
foreach ($paymentSettings as $field => [$label, $default]) { ?>
<div class="col-md-6 mb-3">
    <?php $this->Form->label($label, $field, ['class' => 'form-label']); ?>
    <?php $this->Form->fieldText($field, $meta[$field] ?? $default, ['id' => $field, 'class' => 'form-control', 'inputmode' => 'numeric']); ?>
</div>
<?php } ?>
</div>
<p class="form-text">Use a dedicated wallet or a subaddress index range reserved for this installation. Full payment must be detected before the quote expires; confirmations may arrive later. Late payments require staff review under Tools &gt; Monero Payments.</p>
<p class="form-text">Watch unpaid quotes for 1–8760 hours after expiry (default 24). Watching pauses only after a complete current scan finds no funds. Increasing the window also resumes quotes paused under a shorter window. Staff can resume a paused quote under Monero Payments; detected funds remain watched.</p>
</fieldset>
<div class="form-check mb-3">
    <?php $this->Form->fieldHidden('show_credit', '0'); ?>
    <?php $this->Form->fieldCheckbox('show_credit', '1', ($meta['show_credit'] ?? '1') !== '0', ['id' => 'show_credit', 'class' => 'form-check-input']); ?>
    <?php $this->Form->label('Show author credit', 'show_credit', ['class' => 'form-check-label']); ?>
</div>
<p>Install XMRPay Watch and run the Blesta cron every minute.</p>
<details>
<summary>Existing agent payments</summary>
<p>Keep these settings only while previously issued agent payments remain outstanding.</p>
<div class="mb-3">
    <?php $this->Form->label('Agent URL (loopback)', 'agent_url', ['class' => 'form-label']); ?>
    <?php $this->Form->fieldText('agent_url', $meta['agent_url'] ?? 'http://127.0.0.1:8792', ['id' => 'agent_url', 'class' => 'form-control']); ?>
</div>
<div class="mb-3">
    <?php $this->Form->label('Agent token', 'agent_token', ['class' => 'form-label']); ?>
    <?php $this->Form->fieldPassword('agent_token', ['value' => $meta['agent_token'] ?? '', 'id' => 'agent_token', 'class' => 'form-control']); ?>
</div>
<div class="mb-3">
    <?php $this->Form->label('Webhook secret', 'webhook_secret', ['class' => 'form-label']); ?>
    <?php $this->Form->fieldPassword('webhook_secret', ['value' => $meta['webhook_secret'] ?? '', 'id' => 'webhook_secret', 'class' => 'form-control']); ?>
</div>
<p>Webhook URL: <code><?php echo $this->Html->safe(Configure::get('Blesta.gw_callback_url') . Configure::get('Blesta.company_id') . '/xmrpay/'); ?></code></p>
</details>
</div>
