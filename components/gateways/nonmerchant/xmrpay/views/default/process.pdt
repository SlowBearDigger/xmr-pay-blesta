<style>
div.float-right.mt-2:has(> .xmrpay-pay) { width: 480px; max-width: 100%; }
.xmrpay-pay {
    --xmr: #ff6600;
    --ink: #1a1a1a;
    --muted: #626873;
    --line: #e5e7eb;
    max-width: 480px;
    margin: 24px auto;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, .06);
    color: var(--ink);
    line-height: 1.45;
}
.xmrpay-pay * { box-sizing: border-box; }
.xmrpay-pay [hidden] { display: none; }
.xmrpay-pay__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line);
}
.xmrpay-pay__brand { font-weight: 700; font-size: 18px; color: #b84700; }
.xmrpay-pay__net { font-size: 12px; color: var(--muted); text-transform: uppercase; }
.xmrpay-pay__body { padding: 24px 20px; text-align: center; }
.xmrpay-pay__title { margin: 0 0 8px; font-size: 20px; font-weight: 700; }
.xmrpay-pay__sub { font-size: 13px; color: var(--muted); }
.xmrpay-pay__amount {
    font-size: 30px;
    font-weight: 700;
    color: #b84700;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
}
.xmrpay-pay__amount span { font-size: 18px; color: var(--ink); }
.xmrpay-pay__qr { display: block; width: 232px; max-width: 100%; height: auto; margin: 20px auto; }
.xmrpay-pay__label { text-align: left; font-size: 12px; font-weight: 600; }
.xmrpay-pay__addr { display: flex; gap: 8px; }
.xmrpay-pay__addr code {
    flex: 1;
    min-width: 0;
    background: #f9fafb;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 12px;
    text-align: left;
    overflow-wrap: anywhere;
    color: var(--ink);
}
.xmrpay-pay__copy {
    min-height: 44px;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 10px;
    padding: 0 14px;
    color: var(--ink);
    cursor: pointer;
}
.xmrpay-pay__open {
    display: block;
    min-height: 44px;
    margin: 18px 0;
    padding: 13px;
    border-radius: 11px;
    background: #b84700;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
}
.xmrpay-pay__open:hover { background: #963a00; color: #fff; }
.xmrpay-pay__copy:focus-visible, .xmrpay-pay__open:focus-visible, .xmrpay-pay__foot a:focus-visible { outline: 2px solid var(--xmr); outline-offset: 2px; }
.xmrpay-pay__notice {
    margin-top: 16px;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    color: #9a3412;
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 13px;
    text-align: left;
}
.xmrpay-pay__status { margin: 20px 0; padding: 16px; background: #f9fafb; border-radius: 10px; }
.xmrpay-pay__status h4 { margin: 0 0 8px; font-size: 17px; font-weight: 600; }
.xmrpay-pay__status p { margin: 0; font-size: 13px; }
.xmrpay-pay__status[data-status="detected"] { color: #9a3412; background: #fff7ed; }
.xmrpay-pay__status[data-status="paid"] { color: #166534; background: #f0fdf4; }
.xmrpay-pay__status[data-status="paid"] h4 { margin: 0; }
.xmrpay-pay__foot { padding: 13px 20px; border-top: 1px solid var(--line); text-align: center; font-size: 12px; }
.xmrpay-pay__foot a { color: var(--muted); text-decoration: none; }
.xmrpay-pay__foot a:hover { color: #b84700; }
@media (max-width: 480px) {
    .xmrpay-pay__addr { flex-direction: column; }
}
</style>
<div class="xmrpay-pay" id="xmrpay-pay">
    <div class="xmrpay-pay__bar">
        <span class="xmrpay-pay__brand">xmr-pay</span>
        <span class="xmrpay-pay__net"><?php echo $this->Html->safe($network); ?></span>
    </div>
    <div class="xmrpay-pay__body">
        <h3 class="xmrpay-pay__title">Monero payment</h3>
        <div class="xmrpay-pay__amount"><?php echo $this->Html->safe($xmr_amount); ?> <span>XMR</span></div>
        <?php if (!empty($status_url)) { ?>
        <div class="xmrpay-pay__status" id="xmrpay-status" role="status" data-poll="<?php echo $this->Html->safe($status_url); ?>">
            <h4 id="xmrpay-status-title">Waiting for payment</h4>
            <p id="xmrpay-status-detail">Updates automatically.</p>
        </div>
        <?php } ?>
        <div id="xmrpay-payment-instructions">
        <p class="xmrpay-pay__sub xmrpay-send">Scan the QR or copy the address. Send the exact amount shown.</p>
        <?php
        $qrOptions = new \chillerlan\QRCode\QROptions(['outputType' => \chillerlan\QRCode\QRCode::OUTPUT_MARKUP_SVG]);
        $qrImage = (new \chillerlan\QRCode\QRCode($qrOptions))->render($payment_uri);
        ?>
        <img class="xmrpay-pay__qr xmrpay-send" src="<?php echo $this->Html->safe($qrImage); ?>" alt="Monero payment QR code" />
        <p class="xmrpay-pay__label" id="xmrpay-addr-label">Payment address</p>
        <div class="xmrpay-pay__addr">
            <code id="xmrpay-addr" aria-labelledby="xmrpay-addr-label"><?php echo $this->Html->safe($address); ?></code>
            <button type="button" class="xmrpay-pay__copy" id="xmrpay-copy" aria-label="Copy the Monero address" hidden>Copy</button>
        </div>
        <p class="xmrpay-pay__sub" id="xmrpay-copy-status" role="status"></p>
        <a class="xmrpay-pay__open xmrpay-send" href="<?php echo $this->Html->safe($payment_uri); ?>">Open Monero wallet</a>
        </div>
        <?php if ($expires_at !== null) { ?>
        <div class="xmrpay-pay__notice" id="xmrpay-deadline">
            <p>Full payment must be detected by <time datetime="<?php echo gmdate('c', $expires_at); ?>"><?php echo gmdate('Y-m-d H:i:s', $expires_at); ?> UTC</time>. Confirmations can arrive later. Late payments need manual review.</p>
        </div>
        <?php } ?>
        <noscript><p class="xmrpay-pay__sub">Check your invoice for payment updates.</p></noscript>
        <?php if (empty($status_url)) { ?>
        <p class="xmrpay-pay__sub">Check your invoice for payment updates.</p>
        <?php } ?>
    </div>
    <?php if (!empty($show_credit)) { ?>
    <div class="xmrpay-pay__foot">
        <a href="https://xmrpay.shop" target="_blank" rel="noopener noreferrer">By SlowBearDigger</a>
    </div>
    <?php } ?>
</div>
<script>
(function () {
    var button = document.getElementById('xmrpay-copy');
    var address = document.getElementById('xmrpay-addr');
    var status = document.getElementById('xmrpay-copy-status');
    button.hidden = false;

    function copied() {
        status.textContent = 'Address copied.';
    }

    function fallback() {
        var selection = window.getSelection();
        var success = false;
        try {
            var range = document.createRange();
            range.selectNodeContents(address);
            selection.removeAllRanges();
            selection.addRange(range);
            success = document.execCommand('copy');
        } catch (error) {}
        if (success) {
            selection.removeAllRanges();
            copied();
        } else {
            status.textContent = 'Copy failed. Select the address manually.';
        }
    }

    button.addEventListener('click', function () {
        status.textContent = '';
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(address.textContent).then(copied, fallback);
            } else {
                fallback();
            }
        } catch (error) {
            fallback();
        }
    });
})();
</script>
<?php if (!empty($status_url)) { ?>
<script>
(function () {
    var host = document.getElementById('xmrpay-status');
    var title = document.getElementById('xmrpay-status-title');
    var detail = document.getElementById('xmrpay-status-detail');
    var instructions = document.getElementById('xmrpay-payment-instructions');
    var deadline = document.getElementById('xmrpay-deadline');
    var timer;
    var busy = false;
    var stopped = false;
    var started = Date.now();

    if (!window.fetch || !window.AbortController) {
        detail.textContent = 'Check your invoice for payment updates.';
        return;
    }

    function schedule(delay) {
        clearTimeout(timer);
        if (!stopped) timer = setTimeout(poll, delay);
    }

    function paint(state) {
        var messages = {
            waiting: ['Waiting for payment', 'Updates automatically.'],
            detected: ['Payment detected', 'Checking amount and confirmations. Do not pay again.'],
            review: ['Payment needs review', 'Contact support before paying.'],
            paid: ['Paid', '']
        };
        if (!Object.prototype.hasOwnProperty.call(messages, state)) {
            throw new Error('Invalid payment status.');
        }
        host.setAttribute('data-status', state);
        title.textContent = messages[state][0];
        detail.textContent = messages[state][1];
        detail.hidden = !messages[state][1];
        instructions.hidden = state === 'paid' || state === 'review';
        document.querySelectorAll('.xmrpay-send').forEach(function (element) {
            element.hidden = state !== 'waiting';
        });
        if (deadline) deadline.hidden = state === 'paid';
        stopped = state === 'paid';
    }

    async function poll() {
        if (stopped || busy) return;
        if (document.hidden) {
            schedule(15000);
            return;
        }
        busy = true;
        var controller = new AbortController();
        var timeout = setTimeout(function () { controller.abort(); }, 10000);
        try {
            var response = await fetch(host.getAttribute('data-poll'), {
                credentials: 'same-origin', cache: 'no-store', mode: 'same-origin',
                redirect: 'error', headers: { 'Accept': 'application/json' }, signal: controller.signal
            });
            if (response.status === 403 || response.status === 404) {
                stopped = true;
                throw new Error('Payment session unavailable.');
            }
            if (!response.ok) throw new Error('Payment status unavailable.');
            var result = await response.json();
            paint(result.status);
        } catch (error) {
            title.textContent = 'Status unavailable';
            detail.textContent = stopped
                ? 'Return to your invoice. Do not pay again.'
                : 'Reconnecting. Do not pay again.';
            host.removeAttribute('data-status');
            instructions.hidden = true;
        } finally {
            clearTimeout(timeout);
            busy = false;
            var elapsed = Date.now() - started;
            var interval = elapsed > 300000 ? 30000 : 6000;
            if (elapsed > 60000 && elapsed <= 300000) interval = 15000;
            schedule(interval);
        }
    }

    document.addEventListener('visibilitychange', function () {
        if (!document.hidden && !stopped) schedule(400);
    });
    instructions.hidden = true;
    poll();
})();
</script>
<?php } ?>
