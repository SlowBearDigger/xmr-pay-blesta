[Unit]
Description=XMRPay Blesta payment agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xmrpay
WorkingDirectory=/var/lib/xmrpay-blesta
EnvironmentFile=/var/lib/xmrpay-blesta/.env
ExecStart=/usr/bin/node /opt/xmrpay-blesta/node_modules/xmr-pay/examples/scanner-agent.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
